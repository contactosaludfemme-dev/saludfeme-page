# ─────────────────────────────────────────────────────────
# Google Calendar API
# Consola: https://console.cloud.google.com/apis/credentials
# ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Obtenido al autorizar una vez con la cuenta de la matrona
GOOGLE_REFRESH_TOKEN=
# ID del calendario donde se crean las citas ("primary" o un calendario dedicado)
# Calendario de contacto.saludfemme@gmail.com
GOOGLE_CALENDAR_ID=primary

# ─────────────────────────────────────────────────────────
# Envío de correos (Resend — https://resend.com)
# ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_DESDE="Matrona Francisca Carrillo <hola@tudominio.cl>"
EMAIL_MATRONA=contacto.saludfemme@gmail.com

# ─────────────────────────────────────────────────────────
# Pago online (Flow — https://www.flow.cl)
# ─────────────────────────────────────────────────────────
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_ENTORNO=sandbox

NEXT_PUBLIC_SITIO_URL=http://localhost:3000
